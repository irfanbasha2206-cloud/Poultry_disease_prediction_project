# ======================================================================
# AvianGuard AI - Environment Configuration Template
# ======================================================================
# Copy this file to '.env' and fill in your actual API keys and credentials:
#   cp .env.example .env
#
# DO NOT commit your actual '.env' file to version control.
# ======================================================================

# --- Google Gemini Multimodal Diagnostic API ---
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_primary_gemini_api_key_here"
GEMINI_API_KEY_SECONDARY="your_backup_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash-lite"

# --- Groq High-Speed Backup LLM Reasoning Engine ---
# Obtain from Groq Console: https://console.groq.com/
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="qwen/qwen3.8-27b"

# --- SMTP Biosecurity Email Alert Configuration ---
# Uses standard Gmail SMTP with an App Password (16 characters)
# Generate App Password: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SENDER="your_sender_email@gmail.com"
SMTP_PASSWORD="your_16_char_gmail_app_password"

# --- Default Alert Notification Recipient ---
DEFAULT_RECIPIENT="farm_manager_or_vet@gmail.com"
